{
  "name": "@glowpilot/hub",
  "version": "0.1.3",
  "private": true,
  "description": "GlowPilot Hub: always-on light master for a Linux server (BlueZ), same engine and API as GlowPilot Desktop",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/hub.cjs --external:node-ble --external:ws",
    "typecheck": "tsc -p .",
    "test": "esbuild test/noyau.test.ts --bundle --platform=node --format=cjs --outfile=dist/test.cjs --log-level=warning && node --test dist/test.cjs"
  },
  "dependencies": {
    "@glowpilot/core": "*",
    "node-ble": "^1.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
